# ---- image ------------------------------------------------------------------------
# A tag from https://hub.docker.com/r/veranalabs/vs-agent/tags
VS_AGENT_VERSION=v2.0.0-dev.116

# ---- identity and corporation -------------------------------------------------
# The corporation this agent acts for (its id on the registry, from the Frontend).
VERANA_CORPORATION_ID=
# BIP-39 mnemonic of the agent's own account. Generate a fresh one; never commit this file.
VERANA_ACCOUNT_MNEMONIC=

# ---- network --------------------------------------------------------------------
VERANA_CHAIN_ID=vna-testnet-1
VERANA_RPC_ENDPOINT_URL=https://rpc.testnet.verana.network
VERANA_INDEXER_BASE_URL=https://idx.testnet.verana.network
# The testnet ECS ecosystem DID, from Environments and endpoints.
TRUSTED_ECS_ECOSYSTEM_DIDS=did:webvh:QmaG8Zk91utJCRpHZ6ruVKwedNEWXUm1vnXvttf6pENZHM:council.testnet.verana.network

# ---- the service --------------------------------------------------------------------
# Your static ngrok domain. The DID is derived from it on first start: never change it.
PUBLIC_API_BASE_URL=https://quiet-otter-example.ngrok-free.app
AGENT_PUBLIC_DID_METHOD=webvh
AGENT_MODE=standalone

# Claims of the ECS Service credential the agent issues to itself.
ECS_CLAIMS_SERVICE_NAME=My Local Test Service
ECS_CLAIMS_SERVICE_TYPE=WEB_PORTAL
ECS_CLAIMS_SERVICE_DESCRIPTION=A VS Agent running on a developer's computer, for testing.
ECS_CLAIMS_SERVICE_MINIMUM_AGE_REQUIRED=0
# Placeholders served by the agent itself, under your ngrok domain.
ECS_CLAIMS_SERVICE_LOGO_URI=https://quiet-otter-example.ngrok-free.app/vt/default/logo.svg
ECS_CLAIMS_SERVICE_TERMS_AND_CONDITIONS_URI=https://quiet-otter-example.ngrok-free.app/vt/default/terms.html
ECS_CLAIMS_SERVICE_PRIVACY_POLICY_URI=https://quiet-otter-example.ngrok-free.app/vt/default/privacy.html

# Claims the agent proposes for its ECS Organization credential (the validator may adjust them).
ECS_CLAIMS_ORG_NAME=Example Company Ltd
ECS_CLAIMS_ORG_LOGO_URI=https://quiet-otter-example.ngrok-free.app/vt/default/logo.svg
ECS_CLAIMS_ORG_REGISTRY_ID=12345678
ECS_CLAIMS_ORG_ADDRESS=1 Example Street, Example City
ECS_CLAIMS_ORG_COUNTRY_CODE=CH

# ---- optional ---------------------------------------------------------------------
# A backend on this computer receives events at host.docker.internal:
# EVENTS_WEBHOOK_URL=http://host.docker.internal:4000/vs-agent/events
AGENT_LOG_LEVEL=info
ADMIN_API_LOG_LEVEL=info

# ---- database ----------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
