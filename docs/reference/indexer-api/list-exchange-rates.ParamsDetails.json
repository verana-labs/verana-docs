{"parameters":[{"name":"base_asset_type","in":"query","schema":{"type":"string","enum":["TU","COIN","FIAT"]},"description":"Filter on base asset type"},{"name":"base_asset","in":"query","schema":{"type":"string"},"description":"Filter on base asset identifier"},{"name":"quote_asset_type","in":"query","schema":{"type":"string","enum":["TU","COIN","FIAT"]},"description":"Filter on quote asset type"},{"name":"quote_asset","in":"query","schema":{"type":"string"},"description":"Filter on quote asset identifier"},{"name":"state","in":"query","schema":{"type":"boolean"},"description":"Filter on state"},{"name":"expire","in":"query","schema":{"type":"string","format":"date-time"},"description":"Return only entries whose expires > expire"},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":1024,"default":64},"description":"Caps the number of items returned"},{"name":"min_id","in":"query","schema":{"type":"string","pattern":"^[0-9]+$"},"description":"Half-open range cursor on id (inclusive)"},{"name":"max_id","in":"query","schema":{"type":"string","pattern":"^[0-9]+$"},"description":"Half-open range cursor on id (exclusive)"},{"name":"sort","in":"query","schema":{"type":"string","enum":["id","+id","-id"],"default":"-id"},"description":"Sort order by id (default -id, newest-first)"}]}